# Copy to .env and fill in. Never commit the real .env.
PORT=8080

# PostgreSQL (pgx / gorm) — matches the bundled docker-compose.yml (host port 5433)
DATABASE_URL=postgres://user:password@localhost:5433/motionplay?sslmode=disable

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=motionplay

# Auth — must be a random value of 32+ characters; the server refuses to
# start with a short or placeholder secret. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
# Defaults to the local Vite dev servers (http://localhost:5173-5176).
# CORS_ORIGINS=https://motionplay.example

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted for client IPs (rate limiting). Leave empty when not behind a proxy.
# TRUSTED_PROXIES=10.0.0.0/8
