# Copy to .env and fill in. Never commit the real .env.
PORT=8080

# PostgreSQL (pgx / gorm) — matches the bundled docker-compose.yml (host port 5433)
DATABASE_URL=postgres://user:password@localhost:5433/motionplay?sslmode=disable

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=motionplay

# Auth
JWT_SECRET=change-me
